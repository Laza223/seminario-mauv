---
// La entrada: el precio impreso en un ticket (ancla tachada, ahorro, cupos) y lo interactivo de la página:
// con el precio de TU corte, cuántos cortes tardás en recuperarla. Cuentas reales, nada inventado.
import Logo from './Logo.astro';
import { event, money, savings, savingsPct, waHref } from '../data/event';

const defaultCut = 15_000;
const minCut = 5_000;
const maxCut = 40_000;
const cutsFor = (price: number) => Math.ceil(event.price / price);
const perHour = Math.round(event.price / event.hours);
const why = [
  { title: 'Un día entero', text: `De ${event.timeLabel} a ${event.endLabel.replace(' aprox.', '')} (aprox.): unos ${money(perHour)} la hora de aprender con Mauv al lado.` },
  { title: `${event.seats.total} lugares`, text: 'Mauv mira el corte de cada uno y responde cada duda.' },
  { title: 'Te lo llevás', text: 'Guía impresa y en PDF, certificado y tu corte hecho ese mismo día.' },
];
---

<section class="entrada" id="entrada" aria-labelledby="entrada-title">
  <h2 id="entrada-title" class="display">Tu lugar</h2>

  <div class="ticket" data-wipe="right">
    <div class="main">
      <Logo class="tlogo" />
      <p class="what">{event.name}</p>
      <dl>
        <div><dt>Día</dt><dd>{event.dayLabel}</dd></div>
        <div><dt>Hora</dt><dd>{event.timeLabel}</dd></div>
        <div><dt>Lugar</dt><dd>{event.venue}, {event.street}, {event.city}</dd></div>
        <div><dt>Incluye</dt><dd>Guía impresa + PDF, certificado y coffee break</dd></div>
      </dl>
    </div>
    <div class="stub">
      <p class="old"><s class="price-old" data-strike aria-label={`Antes ${money(event.anchorPrice)}`}>{money(event.anchorPrice)}</s></p>
      <p class="price">{money(event.price)}</p>
      <p class="save">Ahorrás {money(savings)} ({savingsPct}% menos)</p>
      <p class="left">Quedan <strong>{event.seats.left}</strong> de {event.seats.total} lugares</p>
      <a class="btn btn--paper" href={waHref} data-cta="ticket">Reservar por WhatsApp</a>
    </div>
  </div>
  <p class="note">Reservás por WhatsApp y coordinás el pago directo con Mauv.</p>

  <ul class="why">
    {
      why.map((w) => (
        <li>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
        </li>
      ))
    }
  </ul>

  <div class="calc" data-calc data-price={event.price} style={`--fill: ${((defaultCut - minCut) / (maxCut - minCut)) * 100}%`}>
    <label for="cut">¿Cuánto cobrás un corte?</label>
    <div class="row">
      <output for="cut" data-cut>{money(defaultCut)}</output>
      <input id="cut" type="range" min={minCut} max={maxCut} step="1000" value={defaultCut} />
    </div>
    <p class="result" aria-live="polite">
      La recuperás con <strong data-cuts>{cutsFor(defaultCut)} cortes</strong>. Lo que aprendas lo cobrás en cada
      corte que viene.
    </p>
  </div>
</section>

<style>
  .entrada {
    padding: 0 var(--m) var(--gap-section);
    display: grid;
    justify-items: center;
    gap: 40px;
  }
  h2 {
    font-size: var(--t-lg);
    justify-self: start;
  }
  /* El ticket: dos partes (7fr 3fr) con muescas y troquel de puntos donde se juntan. */
  .ticket {
    --notch: 28px;
    position: relative;
    width: min(100%, 1040px);
    display: grid;
    grid-template-columns: 7fr 3fr;
    background: var(--paper);
    color: var(--paper-ink);
  }
  .ticket::before,
  .ticket::after {
    content: '';
    position: absolute;
    left: 70%;
    width: var(--notch);
    height: var(--notch);
    border-radius: 50%;
    background: var(--bg);
    translate: -50% 0;
  }
  .ticket::before {
    top: calc(var(--notch) / -2);
  }
  .ticket::after {
    bottom: calc(var(--notch) / -2);
  }
  .main {
    padding: 40px;
    display: grid;
    gap: 24px;
    align-content: start;
  }
  .main :global(.tlogo) {
    width: 96px;
  }
  .what {
    font-size: var(--t-md);
    font-stretch: var(--wide);
    font-weight: 600;
    line-height: 0.95;
    text-transform: uppercase;
    max-width: 12ch;
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 32px;
  }
  dt {
    font-size: var(--t-sm);
    color: var(--paper-muted);
  }
  dd {
    margin: 2px 0 0;
    font-weight: 560;
  }
  .stub {
    position: relative;
    padding: 40px 28px;
    display: grid;
    gap: 6px;
    align-content: center;
    text-align: center;
    /* Troquel del ticket: una columna de puntos del color del fondo (no es un degradé). */
    background-image: radial-gradient(circle, var(--bg) 3px, transparent 3.5px); /* taste-skill-ignore: troquel */
    background-size: 6px 14px;
    background-repeat: repeat-y;
    background-position: 0 0;
  }
  .old {
    font-size: var(--t-md);
  }
  /* El tachado es un fondo (no un text-decoration) para poder dibujarlo de izquierda a derecha. */
  .old .price-old {
    color: var(--paper-muted);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 56% / 100% 2px; /* taste-skill-ignore: tachado dibujable */
  }
  .price {
    font-size: var(--t-lg);
    font-stretch: var(--wide);
    font-weight: 640;
    line-height: 1;
  }
  .save {
    font-weight: 600;
  }
  .left {
    margin: 14px 0 18px;
    font-size: var(--t-sm);
  }
  .stub .btn {
    width: 100%;
  }
  .note {
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .why {
    list-style: none;
    margin: 0;
    padding: 0;
    width: min(100%, 1040px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px 40px;
  }
  .why h3 {
    margin: 0 0 6px;
    font-size: var(--t-md);
    font-stretch: 112%;
    font-weight: 620;
  }
  .why p {
    max-width: 30ch;
  }

  .calc {
    width: min(100%, 1040px);
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }
  label {
    font-size: var(--t-md);
    font-stretch: 112%;
    font-weight: 600;
  }
  .row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    align-items: center;
  }
  output {
    min-width: 6.5ch;
    font-size: var(--t-md);
    font-stretch: var(--wide);
  }
  /* Slider propio: la parte recorrida va rellena y la perilla crece al tocarla. */
  input[type='range'] {
    width: 100%;
    height: 44px;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--ink) var(--fill), rgb(243 242 239 / 0.22) var(--fill)); /* taste-skill-ignore: relleno del slider */
  }
  input[type='range']::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: rgb(243 242 239 / 0.22);
  }
  input[type='range']::-moz-range-progress {
    height: 4px;
    border-radius: 2px;
    background: var(--ink);
  }
  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 24px;
    height: 24px;
    margin-top: -10px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    transition: transform 0.15s var(--ease);
  }
  input[type='range']::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
    transition: transform 0.15s var(--ease);
  }
  input[type='range']:active::-webkit-slider-thumb {
    transform: scale(1.25);
  }
  input[type='range']:active::-moz-range-thumb {
    transform: scale(1.25);
  }
  .result {
    font-size: var(--t-md);
    line-height: 1.35;
    max-width: 52ch;
  }
  .result strong {
    font-stretch: 112%;
  }

  @media (max-width: 699px) {
    .why {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 899px) {
    .ticket {
      grid-template-columns: 1fr;
    }
    .ticket::before,
    .ticket::after {
      top: auto;
      bottom: auto;
      left: auto;
      translate: none;
    }
    .ticket::before {
      left: calc(var(--notch) / -2);
      top: var(--split);
    }
    .ticket::after {
      right: calc(var(--notch) / -2);
      top: var(--split);
    }
    .ticket {
      --split: calc(100% - 330px - var(--notch) / 2);
    }
    .main {
      padding: 28px 24px;
    }
    dl {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .stub {
      padding: 32px 24px;
      background-image: radial-gradient(circle, var(--bg) 3px, transparent 3.5px); /* taste-skill-ignore: troquel */
      background-size: 14px 6px;
      background-repeat: repeat-x;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>

<script>
  // Calculadora: con el precio de tu corte, cuántos cortes tardás en recuperar la entrada.
  const box = document.querySelector<HTMLElement>('[data-calc]');
  if (box) {
    const price = Number(box.dataset.price);
    const input = box.querySelector<HTMLInputElement>('input')!;
    const out = box.querySelector<HTMLElement>('[data-cut]')!;
    const cuts = box.querySelector<HTMLElement>('[data-cuts]')!;
    const fmt = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 });
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const label = (n: number) => `${n} ${n === 1 ? 'corte' : 'cortes'}`;
    let shown = Math.ceil(price / Number(input.value));
    let raf = 0;
    // El resultado cuenta de un valor al otro en 180 ms en vez de saltar.
    const countTo = (to: number) => {
      cancelAnimationFrame(raf);
      const from = shown;
      const t0 = performance.now();
      const step = (t: number) => {
        const k = calm ? 1 : Math.min(1, (t - t0) / 180);
        shown = Math.round(from + (to - from) * k);
        cuts.textContent = label(shown);
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const update = () => {
      const v = Number(input.value);
      out.textContent = fmt.format(v).replace(/\s/g, '');
      box.style.setProperty('--fill', `${((v - Number(input.min)) / (Number(input.max) - Number(input.min))) * 100}%`);
      countTo(Math.ceil(price / v));
    };
    input.addEventListener('input', update);
  }
</script>
