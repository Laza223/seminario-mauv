---
// Escasez y urgencia REALES: el studio cierra los domingos (su bio), la cuenta regresiva al inicio y los cupos de event.ts.
import { Image } from 'astro:assets';
import photo from '../assets/ig/foto-03.jpg';
import { event } from '../data/event';
---

<section class="domingo" aria-labelledby="domingo-title">
  <div class="text">
    <h2 id="domingo-title" class="display">Domingo cerrado.</h2>
    <p class="lede">
      Los domingos el studio no abre. El 22 abre para un solo grupo: el que se anota. Son {event.seats.total} lugares, a propósito: así Mauv mira el corte de cada uno y cada duda tiene respuesta.
    </p>

    <div class="count" data-ui data-countdown={event.startsAt} aria-live="off">
      <p class="sr-only">Faltan para el {event.dayLabel} a las {event.timeLabel}:</p>
      <dl>
        <div><dt>días</dt><dd data-u="d">--</dd></div>
        <div><dt>horas</dt><dd data-u="h">--</dd></div>
        <div><dt>min</dt><dd data-u="m">--</dd></div>
        <div><dt>seg</dt><dd data-u="s">--</dd></div>
      </dl>
    </div>

    <p class="seats" data-seats>
      <span class="live" aria-hidden="true"></span>Quedan <strong>{event.seats.left}</strong> de {event.seats.total} lugares
    </p>
  </div>

  <figure class="photo">
    <Image src={photo} alt="Corte con flequillo recto y fade, de perfil" widths={[480, 800]} sizes="(min-width: 900px) 34vw, 70vw" />
  </figure>
</section>

<style>
  .domingo {
    background: var(--paper);
    color: var(--paper-ink);
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding: clamp(96px, 12vw, 180px) var(--m);
  }
  h2 {
    font-size: var(--t-lg);
    max-width: 12ch;
  }
  .lede {
    margin-top: 28px;
    max-width: 44ch;
    font-size: var(--t-body);
  }
  dl {
    display: flex;
    gap: clamp(18px, 3vw, 40px);
    margin: 44px 0 0;
  }
  dl div {
    display: flex;
    flex-direction: column-reverse;
  }
  dd {
    margin: 0;
    font-size: var(--t-lg);
    font-weight: 300;
    font-stretch: var(--wide);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  dt {
    margin-top: 6px;
    font-size: var(--t-sm);
    color: var(--paper-muted);
  }
  .seats {
    margin-top: 36px;
    font-size: var(--t-md);
    font-stretch: 112%;
  }
  .seats strong {
    font-weight: 700;
  }
  /* Punto de "disponible ahora": late solo mientras se ve (lo prende el script) y se queda quieto con reduced-motion. */
  .live {
    position: relative;
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 12px;
    border-radius: 50%;
    background: var(--paper-ink);
  }
  .live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--paper-ink);
    opacity: 0;
    animation: ping 2.4s var(--ease) infinite paused;
  }
  [data-live] .live::after {
    animation-play-state: running;
  }
  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live::after {
      animation: none;
    }
  }
  .photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (max-width: 899px) {
    .domingo {
      grid-template-columns: 1fr;
    }
    .photo {
      width: 72%;
      justify-self: end;
    }
    dl {
      justify-content: space-between;
    }
  }
</style>

<script>
  // Cuenta regresiva al instante real de inicio (con -03:00). Sin JS quedan los guiones y la fecha sigue arriba.
  const el = document.querySelector<HTMLElement>('[data-countdown]');
  if (el?.dataset.countdown) {
    const target = Date.parse(el.dataset.countdown);
    const units = Object.fromEntries(
      Array.from(el.querySelectorAll<HTMLElement>('[data-u]')).map((n) => [n.dataset.u ?? '', n]),
    );
    const pad = (n: number) => String(n).padStart(2, '0');
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Solo el dígito que cambió se mueve: baja desde arriba, corto.
    const set = (n: HTMLElement, value: string, animate: boolean) => {
      if (n.textContent === value) return;
      n.textContent = value;
      if (animate && !calm) {
        n.animate([{ transform: 'translateY(-35%)', opacity: 0 }, { transform: 'none', opacity: 1 }], {
          duration: 220,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        });
      }
    };
    let first = true;
    const tick = () => {
      const left = Math.max(0, target - Date.now());
      const s = Math.floor(left / 1000);
      set(units.d, String(Math.floor(s / 86400)), !first);
      set(units.h, pad(Math.floor((s % 86400) / 3600)), !first);
      set(units.m, pad(Math.floor((s % 3600) / 60)), !first);
      set(units.s, pad(s % 60), !first);
      first = false;
    };
    tick();
    setInterval(tick, 1000);
  }

  // El punto de los cupos solo late mientras la línea está a la vista.
  const seats = document.querySelector<HTMLElement>('[data-seats]');
  if (seats) {
    new IntersectionObserver(([e]) => seats.toggleAttribute('data-live', e.isIntersecting)).observe(seats);
  }
</script>
