---
// Barra fija abajo en el celu: precio + cupos + botón siempre a mano después del héroe (en el cierre se esconde).
import { event, money, waHref } from '../data/event';
---

<div class="sticky" data-sticky hidden>
  <p>
    <strong>{money(event.price)}</strong>
    <span>Quedan {event.seats.left} lugares</span>
  </p>
  <a class="btn" href={waHref} data-cta="sticky">Reservar</a>
</div>

<style>
  .sticky {
    position: fixed;
    inset: auto 0 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px var(--m) calc(12px + env(safe-area-inset-bottom));
    background: var(--surface);
    transform: translateY(110%);
    transition: transform 0.35s var(--ease);
  }
  .sticky[data-on] {
    transform: none;
  }
  .sticky[hidden] {
    display: none;
  }
  p {
    display: grid;
    line-height: 1.2;
  }
  strong {
    font-size: var(--t-md);
    font-stretch: 112%;
  }
  span {
    font-size: var(--t-sm);
    color: var(--muted);
  }
  .btn {
    --h: 48px;
    flex: 0 0 auto;
  }
  @media (min-width: 900px) {
    .sticky {
      display: none !important;
    }
  }
</style>

<script>
  // Aparece cuando el botón del héroe ya salió por arriba (no se duplican dos "Reservar" a la vista) y desaparece
  // cuando se ve el cierre, que tiene su propio botón.
  const bar = document.querySelector<HTMLElement>('[data-sticky]');
  const cta = document.querySelector<HTMLElement>('[data-cta="hero"]');
  const end = document.querySelector<HTMLElement>('.cierre');
  if (bar && cta) {
    bar.hidden = false;
    let pastHero = false;
    let atEnd = false;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let nudged = false;
    const sync = () => {
      const on = pastHero && !atEnd;
      bar.toggleAttribute('data-on', on);
      // Una sola vez, a los 3 s de ver la barra, el botón respira para llamar la atención sin insistir.
      if (on && !nudged && !calm) {
        nudged = true;
        setTimeout(() => {
          if (bar.hasAttribute('data-on')) {
            bar.querySelector('.btn')?.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.06)' }, { transform: 'scale(1)' }], {
              duration: 700,
              easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            });
          }
        }, 3000);
      }
    };
    new IntersectionObserver(([e]) => {
      pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
      sync();
    }).observe(cta);
    if (end) {
      new IntersectionObserver(([e]) => {
        atEnd = e.isIntersecting;
        sync();
      }).observe(end);
    }
  }
</script>
