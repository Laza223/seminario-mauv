---
// Héroe — "El nombre como monumento" (elegido en el checkpoint 1): un corte real de Mauv de fondo, el nombre
// enorme abajo y la fecha, el precio y el botón encima. Foto fija: se enfoca al cargar y el nombre sale de una
// máscara; después la barra fija toma el relevo del botón.
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import photo from '../assets/ig/hero-mullet.jpg';
import { event, money, waHref } from '../data/event';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="stage">
    <div class="media" aria-hidden="true">
      <Image src={photo} alt="" widths={[480, 720, 1080]} sizes="(orientation: landscape) 60vh, 100vw" loading="eager" fetchpriority="high" class="pic" />
    </div>
    <div class="scrim" aria-hidden="true"></div>

    <header class="bar">
      <a href="#top" class="brand" aria-label="MAUV311"><Logo class="logo" /></a>
      <a class="btn btn--bar" href={waHref} data-cta="bar">Reservar</a>
    </header>

    <h1 id="hero-title" class="display">
      <span class="k">Perfeccionamiento</span>
      <span class="n"><span class="n1">MAUV</span><span class="n2">311</span></span>
    </h1>

    <div class="info">
      <p class="when">{event.dayLabel}<br />{event.timeLabel} · {event.venue}, {event.city}</p>
      <div class="act">
        <p class="sub">Un día entero de fade, contornos y estructura. Explicado técnico y en criollo.</p>
        <div class="buy" data-ui>
          <p class="price">
            <s class="price-old" aria-label={`Antes ${money(event.anchorPrice)}`}>{money(event.anchorPrice)}</s>
            <strong>{money(event.price)}</strong>
          </p>
          <a class="btn" href={waHref} data-cta="hero">Reservar mi lugar</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }
  .stage {
    position: relative; /* contiene a .media y .scrim: el foco inicial (scale) no se sale ni mide de más */
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    /* Alto de una línea del nombre: el bloque de info se apoya arriba de él. */
    --name: calc((100vw - 2 * var(--m)) / 5.9);
    --name-h: calc(var(--name) * 0.74);
  }
  .media,
  .scrim {
    position: absolute;
    inset: 0;
  }
  .pic {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    animation: focus 1.6s var(--ease) both;
  }
  .media {
    background: #000;
  }
  /* En vertical (celu) la foto ocupa la parte de arriba, entera y sin tapar la cara con el texto: abajo se funde
     en negro y ahí van la fecha, el precio y el nombre. */
  @media (orientation: portrait) {
    .media {
      background: var(--bg);
    }
    .pic {
      height: 68%;
      object-position: 24% 0;
      mask-image: linear-gradient(to bottom, #000 72%, transparent); /* taste-skill-ignore: la foto se funde en el negro del texto */
    }
  }
  /* Tablet vertical: la foto no se estira al ancho (perdería la cara bajo el texto): columna centrada, fundida a los costados. */
  @media (orientation: portrait) and (min-width: 600px) {
    .pic {
      width: auto;
      margin-inline: auto;
      aspect-ratio: 1135 / 1492;
      object-position: 50% 0;
      mask-image: linear-gradient(to bottom, #000 72%, transparent), linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent); /* taste-skill-ignore: fundido de la foto */
      mask-composite: intersect;
    }
  }
  /* En horizontal la foto vertical va entera, como una columna centrada del alto del héroe,
     con los costados fundidos en un negro igual al suyo: sin tira de bordes duros. */
  @media (orientation: landscape) {
    .media {
      background: #0a0a0a;
    }
    .pic {
      width: auto;
      margin-inline: auto;
      aspect-ratio: 1135 / 1492;
      mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent); /* taste-skill-ignore: fundido de los bordes de la foto vertical */
    }
  }
  /* Velo neutro solo donde va texto: la única excepción a "sin degradés". */
  .scrim {
    background: linear-gradient( /* taste-skill-ignore: velo neutro bajo el texto, sobre la foto */
      to bottom,
      rgb(11 11 11 / 0.55),
      rgb(11 11 11 / 0.1) 28%,
      rgb(11 11 11 / 0.2) 50%,
      rgb(11 11 11 / 0.92)
    );
  }

  .bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px var(--m);
  }
  .brand :global(.logo) {
    width: 88px;
    color: var(--ink);
  }
  .btn--bar {
    --h: 44px;
    padding: 0 20px;
    font-size: var(--t-sm);
  }

  h1 {
    position: relative;
    z-index: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px var(--m) 0;
  }
  .k {
    font-size: var(--t-md);
    font-weight: 380;
    letter-spacing: 0.32em;
    line-height: 1;
  }
  .n {
    font-size: var(--name);
    font-weight: 600;
    line-height: 0.74;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .n2 {
    font-weight: 220;
  }

  .info {
    position: absolute;
    z-index: 1;
    inset: auto 0 calc(var(--name-h) + 24px);
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    padding: 0 var(--m);
  }
  .when {
    font-size: var(--t-md);
    font-stretch: 112%;
    line-height: 1.25;
  }
  .act {
    width: min(34ch, 100%);
    display: grid;
    gap: 14px;
  }
  .sub {
    font-size: var(--t-body);
    line-height: 1.45;
  }
  .buy {
    display: grid;
    gap: 14px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--t-md);
  }
  .price strong {
    font-weight: 640;
    font-stretch: 112%;
  }

  /* Entrada en CSS puro (corre sin esperar a JS; con reduced-motion queda en 0,01 ms, global.css): la foto se enfoca,
     el nombre sube desde una máscara y la info llega después. */
  .k,
  .info > * {
    animation: rise 0.9s var(--ease) both;
  }
  .n1,
  .n2 {
    display: inline-block;
    animation: unmask 1s var(--ease) both;
  }
  .n1 {
    animation-delay: 0.12s;
  }
  .n2 {
    animation-delay: 0.24s;
  }
  .info > :first-child {
    animation-delay: 0.4s;
  }
  .info > :last-child {
    animation-delay: 0.5s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes unmask {
    from {
      clip-path: inset(100% -5% -30% -5%);
      transform: translateY(32%);
    }
    to {
      clip-path: inset(-30% -5% -30% -5%);
    }
  }
  @keyframes focus {
    from {
      transform: scale(1.07);
    }
  }

  /* Celu: el nombre se apila (MAUV / 311) para ser de verdad monumental en 390 px. */
  @media (max-width: 899px) {
    .stage {
      --name: calc((100vw - 2 * var(--m)) / 3.8);
      --name-h: calc(var(--name) * 0.74 * 2 + 4px);
    }
    .brand :global(.logo) {
      width: 74px;
    }
    .k {
      font-size: 1rem;
      letter-spacing: 0.2em;
    }
    .n {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .info {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      bottom: calc(var(--name-h) + 20px);
    }
    .when {
      font-size: 1.25rem;
    }
    .sub {
      font-size: 1rem;
    }
    .buy {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
    .price {
      flex-direction: column;
      gap: 0;
      font-size: var(--t-md);
      line-height: 1.15;
    }
    .price s {
      font-size: var(--t-sm);
    }
  }
  /* Celu acostado: el nombre apilado no entra en el alto; vuelve a una línea, como en escritorio. */
  @media (max-width: 899px) and (orientation: landscape) {
    .stage {
      --name: calc((100vw - 2 * var(--m)) / 5.9);
      --name-h: calc(var(--name) * 0.74);
    }
    .n {
      flex-direction: row;
      gap: 0;
    }
    .act {
      width: min(44ch, 100%);
    }
  }
</style>
