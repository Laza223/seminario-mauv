---
// Héroe — "El nombre como monumento" (elegido en el checkpoint 1): el logo de Mauv grande como emblema, el nombre
// enorme abajo y la fecha, el precio y el botón en el medio. El logo se traza al cargar (de izquierda a derecha) y el
// nombre sale de una máscara; después la barra fija toma el relevo del botón.
import Logo from './Logo.astro';
import { event, money, waHref } from '../data/event';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="stage">
    <div class="media" aria-hidden="true">
      <Logo class="mark mark--ghost" />
      <Logo class="mark" />
    </div>

    <header class="bar">
      <a class="btn btn--bar" href={waHref} data-cta="bar">Reservar</a>
    </header>

    <h1 id="hero-title" class="display">
      <span class="k">Perfeccionamiento</span>
      <span class="n"><span class="n1">MAUV</span><span class="n2">311</span></span>
    </h1>

    <div class="info">
      <p class="when">{event.dayLabel}<br />{event.timeLabel} · {event.venue}, {event.city}</p>
      <div class="act">
        <p class="sub">Un día entero de fade, contornos y estructura. Explicado técnico y en criollo.</p>
        <div class="buy" data-ui>
          <p class="price">
            <s class="price-old" aria-label={`Antes ${money(event.anchorPrice)}`}>{money(event.anchorPrice)}</s>
            <strong>{money(event.price)}</strong>
          </p>
          <a class="btn" href={waHref} data-cta="hero">Reservar mi lugar</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }
  .stage {
    position: relative; /* contiene a .media: la copia enorme del logo se recorta en el borde del héroe */
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    /* Alto de una línea del nombre: el bloque de info se apoya arriba de él. */
    --name: calc((100vw - 2 * var(--m)) / 5.9);
    --name-h: calc(var(--name) * 0.74);
  }
  /* El emblema: el logo ocupa la zona libre entre el rótulo de arriba y el bloque de info. Atrás, una copia enorme y
     casi invisible (3 % de tinta) que da escala sin competir con nada. */
  .media {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 120px var(--m) calc(var(--name-h) + 230px);
    background: var(--bg);
  }
  .media :global(.mark) {
    grid-area: 1 / 1;
    width: min(100%, 560px);
    height: auto;
    color: var(--ink);
    animation: trace 1.5s var(--ease) 0.1s both;
  }
  .media :global(.mark--ghost) {
    position: absolute;
    left: 50%;
    top: 38%;
    translate: -50% -50%;
    width: 230%;
    max-width: none;
    opacity: 0.03;
    animation-delay: 0s;
  }
  @keyframes trace {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 -1% 0 -1%);
    }
  }
  @media (min-width: 900px) {
    .media {
      padding-bottom: calc(var(--name-h) + 56px);
    }
    .media :global(.mark) {
      width: min(52vw, 700px);
    }
    .media :global(.mark--ghost) {
      width: 150vw;
    }
  }

  .bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 18px var(--m);
  }
  .btn--bar {
    --h: 44px;
    padding: 0 20px;
    font-size: var(--t-sm);
  }

  h1 {
    position: relative;
    z-index: 1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px var(--m) 0;
  }
  .k {
    font-size: var(--t-md);
    font-weight: 380;
    letter-spacing: 0.32em;
    line-height: 1;
  }
  .n {
    font-size: var(--name);
    font-weight: 600;
    line-height: 0.74;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .n2 {
    font-weight: 220;
  }

  .info {
    position: absolute;
    z-index: 1;
    inset: auto 0 calc(var(--name-h) + 24px);
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 32px;
    padding: 0 var(--m);
  }
  .when {
    font-size: var(--t-md);
    font-stretch: 112%;
    line-height: 1.25;
  }
  .act {
    width: min(34ch, 100%);
    display: grid;
    gap: 14px;
  }
  .sub {
    font-size: var(--t-body);
    line-height: 1.45;
  }
  .buy {
    display: grid;
    gap: 14px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--t-md);
  }
  .price strong {
    font-weight: 640;
    font-stretch: 112%;
  }

  /* Entrada en CSS puro (corre sin esperar a JS; con reduced-motion queda en 0,01 ms, global.css): el logo se traza,
     el nombre sube desde una máscara y la info llega después. */
  .k,
  .info > * {
    animation: rise 0.9s var(--ease) both;
  }
  .n1,
  .n2 {
    display: inline-block;
    animation: unmask 1s var(--ease) both;
  }
  .n1 {
    animation-delay: 0.12s;
  }
  .n2 {
    animation-delay: 0.24s;
  }
  .info > :first-child {
    animation-delay: 0.4s;
  }
  .info > :last-child {
    animation-delay: 0.5s;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes unmask {
    from {
      clip-path: inset(100% -5% -30% -5%);
      transform: translateY(32%);
    }
    to {
      clip-path: inset(-30% -5% -30% -5%);
    }
  }

  /* Celu: el nombre se apila (MAUV / 311) para ser de verdad monumental en 390 px. */
  @media (max-width: 899px) {
    .stage {
      --name: calc((100vw - 2 * var(--m)) / 3.8);
      --name-h: calc(var(--name) * 0.74 * 2 + 4px);
    }
    .k {
      font-size: 1rem;
      letter-spacing: 0.2em;
    }
    .n {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .info {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      bottom: calc(var(--name-h) + 20px);
    }
    .when {
      font-size: 1.25rem;
    }
    .sub {
      font-size: 1rem;
    }
    .buy {
      grid-template-columns: auto 1fr;
      align-items: center;
    }
    .price {
      flex-direction: column;
      gap: 0;
      font-size: var(--t-md);
      line-height: 1.15;
    }
    .price s {
      font-size: var(--t-sm);
    }
  }
  /* Celu acostado: el nombre apilado no entra en el alto; vuelve a una línea, como en escritorio. */
  @media (max-width: 899px) and (orientation: landscape) {
    .media {
      padding-bottom: calc(var(--name-h) + 214px);
    }
    .media :global(.mark) {
      width: min(100%, 300px);
    }
    .stage {
      --name: calc((100vw - 2 * var(--m)) / 5.9);
      --name-h: calc(var(--name) * 0.74);
    }
    .n {
      flex-direction: row;
      gap: 0;
    }
    .act {
      width: min(44ch, 100%);
    }
  }
</style>
